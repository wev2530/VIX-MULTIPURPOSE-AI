# These two are PUBLIC by design (the publishable key is meant to ship in the browser — Row
# Level Security is what actually protects the data) and are already hardcoded in js/config.js,
# so there's nothing to set for the frontend. Listed here only for reference.
SUPABASE_URL=https://yywrtzwfrlpasjqxatpw.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7f8t8QNFhgKM1diXZUKZvA_Bq2mDB8M

# The ONE real secret this project needs. Set it on Supabase directly (never in a committed
# file, never pasted into chat with Claude):
#   supabase secrets set HF_TOKEN=hf_xxxxxxxx --project-ref yywrtzwfrlpasjqxatpw
# or: Supabase dashboard -> Project Settings -> Edge Functions -> Secrets.
# A personal Hugging Face access token (Read scope). Gets a much larger ZeroGPU quota than
# anonymous requests — see README.md "AI backend" for details.
HF_TOKEN=

